generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  avatar        String?
  xp            Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fantasyTeams  FantasyTeam[]
  ownedLeagues  League[]       @relation("LeagueOwner")
  leagueMembers LeagueMember[]
}

model League {
  id         String         @id @default(cuid())
  name       String
  inviteCode String         @unique
  ownerId    String
  createdAt  DateTime       @default(now())
  owner      User           @relation("LeagueOwner", fields: [ownerId], references: [id])
  members    LeagueMember[]
}

model LeagueMember {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  joinedAt DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, leagueId])
}

model Match {
  id            String        @id @default(cuid())
  team1         String
  team2         String
  date          DateTime
  status        String        @default("UPCOMING")
  tossCompleted Boolean       @default(false)
  createdAt     DateTime      @default(now())
  fantasyTeams  FantasyTeam[]
  playing11     MatchPlayer[]
}

model Player {
  id               String              @id @default(cuid())
  name             String
  team             String
  role             String
  credits          Float               @default(9.0)
  fantasyPicks     FantasyTeamPlayer[]
  matchAppearances MatchPlayer[]
  stats            PlayerStats[]
}

model FantasyTeam {
  id            String              @id @default(cuid())
  userId        String
  matchId       String
  captainId     String
  viceCaptainId String
  totalPoints   Float               @default(0)
  createdAt     DateTime            @default(now())
  match         Match               @relation(fields: [matchId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  players       FantasyTeamPlayer[]
}

model FantasyTeamPlayer {
  id            String      @id @default(cuid())
  fantasyTeamId String
  playerId      String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  player        Player      @relation(fields: [playerId], references: [id])

  @@unique([fantasyTeamId, playerId])
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  playerId  String
  isPlaying Boolean @default(false)
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model PlayerStats {
  id            String @id @default(cuid())
  playerId      String
  season        Int
  matchesPlayed Int
  runs          Int
  wickets       Int
  avgPoints     Float
  player        Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
}
