# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/alterego"

# Required in production; the app refuses to start without it. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Leave unset locally. If you set it, use the full site URL: an empty value makes next-auth call new URL("") and the build fails.
# NEXTAUTH_URL="https://your-domain.example"

# Public site URL used for metadata (optional)
NEXT_PUBLIC_SITE_URL=""

# CricketData.org key for live IPL scores
CRICKET_API_KEY=""

# Admin access for the seed, score and toss routes
ADMIN_EMAILS="you@example.com"
CRON_SECRET=""

# Destructive reseed of every table. Never enable in production.
ALLOW_SEED="false"

# Only used by scripts/setup-*.ts
SEED_USER_PASSWORD=""
